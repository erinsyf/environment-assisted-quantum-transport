Cell["Eff - Eff(v[2] -> 0) Series Expansion", "Subsubsection",
 CellChangeTimes->{{3.927378087215415*^9, 3.927378098624905*^9}},
 FontSize->16,ExpressionUUID->"ac8c15b7-1ede-424d-bfc3-7c0f4b131013"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Veffv2", "=", 
