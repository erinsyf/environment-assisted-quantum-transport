 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HS", "[", 
      RowBox[{"[", 
       RowBox[{"k", ",", " ", 
        RowBox[{"k", "+", "1"}]}], "]"}], "]"}], "=", 
